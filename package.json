{
  "name": "gs-openrouter-quota",
  "version": "0.4.0",
  "description": "OpenRouter quota for Pi and Gentle Shell: alt+u usage integration and a /openrouter detail command with threshold alerts.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "gentle-shell",
    "openrouter",
    "quota",
    "usage"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions",
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asolis87/gs-openrouter-quota.git"
  },
  "homepage": "https://github.com/asolis87/gs-openrouter-quota#readme",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
